# SecOps Pulse Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
# Default values work for local development with Docker
DATABASE_URL=postgresql+asyncpg://secops_user:secops_password@localhost:5432/secops_pulse

# Google Gemini AI Configuration
# Required for AI-powered analysis features
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDNWjWuFFgr_rTx-CMrIfsWTrGyfjDw6pM

# AI Model Settings
# gemini-1.5-flash: Fast and efficient for most tasks
# gemini-1.5-pro: More capable for complex analysis
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.2

# Risk Scoring Thresholds
HIGH_RISK_THRESHOLD=7
MEDIUM_RISK_THRESHOLD=4

# Application Settings
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
